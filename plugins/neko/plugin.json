{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "neko",
  "version": "2.4.0",
  "description": "Build and analyze signalling networks from interaction databases with NeKo.",
  "author": {
    "name": "Marco Ruscone"
  },
  "homepage": "https://github.com/marcorusc/mcp-biomodelling-servers",
  "repository": "https://github.com/marcorusc/mcp-biomodelling-servers",
  "license": "MIT",
  "keywords": [
    "mcp",
    "systems-biology",
    "bioinformatics",
    "neko"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "NeKo Network Builder",
        "shortDescription": "Signalling networks from interaction databases",
        "longDescription": "Build and analyze signalling networks from interaction databases with NeKo. Runs the NeKo MCP server from the published mcp-biomodelling-servers package with uvx.",
        "developerName": "Marco Ruscone",
        "category": "Research",
        "capabilities": [
          "Read",
          "Write"
        ],
        "defaultPrompt": [
          "Build a signalling network for TP53"
        ]
      }
    }
  }
}
